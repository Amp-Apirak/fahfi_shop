{
  "info": {
    "_postman_id": "fahfi-shop-api-collection-v2",
    "name": "fahfi_shop API Collection v2 (with User Management)",
    "description": "การทดสอบ API ระบบจัดการร้านเสื้อผ้า (fahfi_shop) - รุ่นที่ 2 พร้อม User Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "1. Register - ลงทะเบียนผู้ใช้ใหม่",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser1\",\n  \"password\": \"password123\",\n  \"role\": \"Staff\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "register"]
            },
            "description": "ลงทะเบียนผู้ใช้ใหม่ในระบบ"
          },
          "response": []
        },
        {
          "name": "2. Login - เข้าสู่ระบบ ⭐ สำคัญ",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "    pm.test(\"Token saved to environment\", function() {",
                  "        pm.expect(jsonData).to.have.property('token');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser1\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            },
            "description": "เข้าสู่ระบบและได้ Token JWT"
          },
          "response": []
        }
      ]
    },
    {
